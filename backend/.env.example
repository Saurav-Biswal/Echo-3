# Echo backend configuration (§40).
# Copy to `.env` and fill in real values. NEVER commit `.env` or real secrets.
# Every value here is optional - the app boots on sane defaults and, with no
# Gemini key, runs fully offline on the deterministic MOCK provider (§45).

# ----------------------------------------------------------------- app
APP_NAME=Echo
APP_ENV=dev                     # dev | test | prod
DEBUG=false
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed dashboard origins. Use explicit origins in prod.
CORS_ORIGINS=*

# ------------------------------------------------------------ database
# SQLite by default; swap to Postgres with no code change:
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/echo
DATABASE_URL=sqlite+aiosqlite:///./echo.db
DATABASE_ECHO=false

# ------------------------------------------------------------------ ai
# "gemini" uses the real API; falls back to "mock" automatically if no key is set.
AI_PROVIDER=gemini
# SECRET - keep this ONLY on the backend. Never ship it in the Android app,
# the APK, frontend JS, or a public repo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_ATTEMPTS=3

# -------------------------------------------------------- confidence (§13)
# >= high -> auto-save; medium..high -> save + confirm; < medium -> needs review.
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.55

# ------------------------------------------------------------- media
MEDIA_MAX_DOWNLOAD_BYTES=83886080
MEDIA_MAX_DURATION_SECONDS=300
MEDIA_ACQUISITION_TIMEOUT_SECONDS=90
# Raw media is kept only for the length of a job, then deleted (§43 privacy).
MEDIA_RETAIN_DOWNLOADS=false

# ---------------------------------------------------------- triggers
GEOFENCE_DEFAULT_RADIUS_METERS=300
GEOFENCE_MIN_RADIUS_METERS=100
GEOFENCE_MAX_RADIUS_METERS=2000
EVENT_REMINDER_LEAD_HOURS=24
DEFAULT_TIME_TRIGGER_DELAY_HOURS=72
TRIGGER_SCAN_INTERVAL_SECONDS=60

# ---------------------------------------------------------- workers
WORKER_CONCURRENCY=2
JOB_QUEUE_MAX_SIZE=256

# -------------------------------------------------------------- auth / demo
DEMO_USER_EMAIL=demo@echo.app
DEMO_USER_NAME=Demo
DEMO_MODE_ENABLED=true
